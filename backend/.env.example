# Copiar como .env y completar con tus datos
# PostgreSQL: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
# Para desarrollo local también sirve SQLite: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db
# Clave para firmar el JWT: al menos 32 caracteres
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origen del frontend (CORS con credenciales). Varios: separados por coma
FRONTEND_ORIGIN=http://localhost:5173
